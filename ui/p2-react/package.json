{
  "name": "@fab-intelligence/p2-process-forensics-panels",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Headless React panel contribution for the FAB Intelligence P1 host.",
  "license": "UNLICENSED",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "test",
    "README.md",
    "tsconfig.json"
  ],
  "peerDependencies": {
    "react": ">=18.2.0 <20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node --test test/*.test.mjs",
    "host:typecheck": "tsc -p tsconfig.host.json --noEmit",
    "host:build": "npm run build && vite build --config vite.config.ts"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.2.2",
    "jsdom": "31.0.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "typescript": "5.9.3",
    "vite": "7.3.8"
  }
}
